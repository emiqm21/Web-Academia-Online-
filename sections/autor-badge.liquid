{% assign author_name = section.settings.author_name %}
{% assign author_title = section.settings.author_title %}
{% assign author_bio = section.settings.author_bio %}
{% assign author_credentials = section.settings.author_credentials %}

<section class="autor-section">
  <div class="autor-container">
    <!-- Avatar placeholder -->
    <div class="autor-avatar" data-aos="fade-up">
      <svg width="120" height="120" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="60" cy="60" r="60" fill="#ece2d5"/>
        <circle cx="60" cy="35" r="20" fill="#5c5c66"/>
        <path d="M35 80c0-13.8 11.2-25 25-25s25 11.2 25 25v20H35V80Z" fill="#5c5c66"/>
      </svg>
    </div>

    <!-- Contenido -->
    <div class="autor-content" data-aos="fade-up" data-aos-delay="100">
      {% if author_name %}
        <h3 class="autor-name">{{ author_name }}</h3>
      {% endif %}

      {% if author_title %}
        <p class="autor-title">{{ author_title }}</p>
      {% endif %}

      {% if author_bio %}
        <p class="autor-bio">{{ author_bio }}</p>
      {% endif %}

      <!-- Credenciales -->
      {% if author_credentials %}
        <div class="autor-credentials">
          {% for credential in author_credentials %}
            <div class="credential-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 6L9 17l-5-5"/>
              </svg>
              <span>{{ credential }}</span>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .autor-section {
    padding: 60px 20px;
    background: #fffaf3;
  }

  .autor-container {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .autor-avatar {
    flex-shrink: 0;
  }

  .autor-avatar svg {
    width: 120px;
    height: 120px;
  }

  .autor-content {
    flex: 1;
  }

  .autor-name {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: #171719;
  }

  .autor-title {
    font-size: 1rem;
    color: #e85f2a;
    font-weight: 600;
    margin: 0 0 16px 0;
  }

  .autor-bio {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #5c5c66;
    margin: 0 0 24px 0;
  }

  .autor-credentials {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .credential-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: #171719;
  }

  .credential-item svg {
    color: #0f8f5f;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .autor-container {
      flex-direction: column;
      text-align: center;
      gap: 24px;
    }

    .autor-content {
      width: 100%;
    }

    .credential-item {
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Autor - Badge",
  "settings": [
    {
      "type": "text",
      "id": "author_name",
      "label": "Nombre del Autor",
      "default": "Santiago Reyes"
    },
    {
      "type": "text",
      "id": "author_title",
      "label": "Título/Especialidad",
      "default": "Psicólogo Clínico especializado en Dinámicas de Pareja"
    },
    {
      "type": "textarea",
      "id": "author_bio",
      "label": "Biografía corta",
      "default": "7+ años acompañando personas en ruptura y reconexión. He trabajado con miles de personas en transiciones relacionales, aplicando principios de psicología comprobados."
    },
    {
      "type": "text",
      "id": "author_credentials",
      "label": "Credenciales (separadas por coma)",
      "default": "Licenciatura en Psicología - Universidad Nacional, Especialización en Teoría del Apego, Certificación en Comunicación No Violenta, Formación en Psicología Cognitiva"
    }
  ]
}
{% endschema %}
