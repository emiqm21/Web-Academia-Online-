{% liquid
  assign quiz_title = section.settings.quiz_title
  assign quiz_description = section.settings.quiz_description
  assign quiz_results_heading = section.settings.quiz_results_heading
%}

<div class="quiz-premium">
  <div class="quiz-premium__header">
    <h2 class="quiz-premium__title">{{ quiz_title }}</h2>
    <p class="quiz-premium__description">{{ quiz_description }}</p>
  </div>

  <div class="quiz-premium__container">
    <!-- Quiz Form -->
    <form id="quizForm" class="quiz-premium__form">
      <div id="quizQuestions" class="quiz-questions"></div>
      
      <div class="quiz-premium__navigation">
        <button type="button" id="prevBtn" class="button button--secondary" style="display:none;">
          ← Anterior
        </button>
        <button type="button" id="nextBtn" class="button button--primary">
          Siguiente →
        </button>
        <button type="submit" id="submitBtn" class="button button--primary" style="display:none;">
          Ver Resultado
        </button>
      </div>
      
      <div class="quiz-progress">
        <div class="quiz-progress__bar">
          <div class="quiz-progress__fill" id="progressFill"></div>
        </div>
        <span class="quiz-progress__text"><span id="currentQuestion">1</span> / <span id="totalQuestions">6</span></span>
      </div>
    </form>

    <!-- Results -->
    <div id="quizResults" class="quiz-premium__results" style="display:none;">
      <div class="results-card">
        <h3 class="results-card__title" id="resultsTitle">{{ quiz_results_heading }}</h3>
        <div class="results-card__content" id="resultsContent"></div>
        <a href="#tableOfContents" class="button button--primary button--large">
          Ver Índice y Capítulo 1
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const quizData = {
      questions: [
        {
          id: 1,
          question: "¿Cuánto tiempo llevas separado(a)?",
          options: [
            { text: "Menos de 1 mes", value: 1 },
            { text: "1-3 meses", value: 2 },
            { text: "3-6 meses", value: 3 },
            { text: "Más de 6 meses", value: 4 }
          ]
        },
        {
          id: 2,
          question: "¿Quién terminó la relación?",
          options: [
            { text: "Mi ex", value: 1 },
            { text: "Yo", value: 2 },
            { text: "Fue mutuo", value: 3 },
            { text: "No estoy seguro(a)", value: 4 }
          ]
        },
        {
          id: 3,
          question: "¿Cuál fue el motivo principal de la ruptura?",
          options: [
            { text: "Problemas de comunicación", value: 1 },
            { text: "Diferencias en objetivos", value: 2 },
            { text: "Conflictos de personalidad", value: 3 },
            { text: "Falta de tiempo/distancia", value: 4 }
          ]
        },
        {
          id: 4,
          question: "¿Cuál es tu disponibilidad emocional actual?",
          options: [
            { text: "Todavía me duele mucho", value: 1 },
            { text: "Estoy mejor pero es difícil", value: 2 },
            { text: "Estoy listo(a) para intentar", value: 3 },
            { text: "Totalmente disponible", value: 4 }
          ]
        },
        {
          id: 5,
          question: "¿Has mantenido contacto con tu ex?",
          options: [
            { text: "No, nada de contacto", value: 1 },
            { text: "Poco contacto casual", value: 2 },
            { text: "Contacto regular", value: 3 },
            { text: "Nos vemos frecuentemente", value: 4 }
          ]
        },
        {
          id: 6,
          question: "¿Qué esperas lograr?",
          options: [
            { text: "Simplemente hablar nuevamente", value: 1 },
            { text: "Recuperar la amistad", value: 2 },
            { text: "Intentar una relación mejor", value: 3 },
            { text: "Casarme y tener familia", value: 4 }
          ]
        }
      ]
    };

    const results = {
      low: {
        title: "🚀 Etapa de Preparación",
        description: "Tu situación requiere tiempo y estrategia. En este ebook aprenderás cómo sanar, trabajar en ti mismo(a) y crear el terreno fértil para una posible reconciliación. El capítulo 1 te mostrará los primeros pasos.",
        icon: "💪"
      },
      medium: {
        title: "⚖️ Etapa de Balance",
        description: "Estás en un punto de inflexión. Es hora de tomar decisiones inteligentes sobre el contacto, la comunicación y los límites. Nuestro ebook te proporciona las herramientas exactas para navegar esta fase crítica.",
        icon: "🎯"
      },
      high: {
        title: "❤️ Etapa de Reconexión",
        description: "Las condiciones son favorables para intentar reconectar. Descubre las estrategias de comunicación, los pasos a seguir y cómo construir una relación más fuerte. El ebook te guiará a través de cada fase.",
        icon: "✨"
      }
    };

    const form = document.getElementById('quizForm');
    const questionsContainer = document.getElementById('quizQuestions');
    const resultsContainer = document.getElementById('quizResults');
    const nextBtn = document.getElementById('nextBtn');
    const prevBtn = document.getElementById('prevBtn');
    const submitBtn = document.getElementById('submitBtn');
    const currentQuestionSpan = document.getElementById('currentQuestion');
    const totalQuestionsSpan = document.getElementById('totalQuestions');
    const progressFill = document.getElementById('progressFill');

    let currentQuestion = 0;
    let answers = {};

    totalQuestionsSpan.textContent = quizData.questions.length;

    function renderQuestion() {
      questionsContainer.innerHTML = '';
      const question = quizData.questions[currentQuestion];
      
      const questionDiv = document.createElement('div');
      questionDiv.className = 'quiz-question';
      
      questionDiv.innerHTML = `
        <h3 class="quiz-question__text">${question.question}</h3>
        <div class="quiz-question__options">
          ${question.options.map(option => `
            <label class="quiz-option">
              <input 
                type="radio" 
                name="question_${question.id}" 
                value="${option.value}"
                ${answers[question.id] == option.value ? 'checked' : ''}
              />
              <span class="quiz-option__label">${option.text}</span>
            </label>
          `).join('')}
        </div>
      `;
      
      questionsContainer.appendChild(questionDiv);
      
      // Save answer
      const radios = questionDiv.querySelectorAll('input[type="radio"]');
      radios.forEach(radio => {
        radio.addEventListener('change', function() {
          answers[question.id] = this.value;
        });
      });

      currentQuestionSpan.textContent = currentQuestion + 1;
      updateProgress();
      updateButtons();
    }

    function updateButtons() {
      prevBtn.style.display = currentQuestion > 0 ? 'inline-flex' : 'none';
      
      if (currentQuestion === quizData.questions.length - 1) {
        nextBtn.style.display = 'none';
        submitBtn.style.display = 'inline-flex';
      } else {
        nextBtn.style.display = 'inline-flex';
        submitBtn.style.display = 'none';
      }
    }

    function updateProgress() {
      const progress = ((currentQuestion + 1) / quizData.questions.length) * 100;
      progressFill.style.width = progress + '%';
    }

    function calculateResults() {
      const total = Object.values(answers).reduce((a, b) => parseInt(a) + parseInt(b), 0);
      const average = total / quizData.questions.length;
      
      let resultLevel;
      if (average <= 1.5) resultLevel = 'low';
      else if (average <= 2.5) resultLevel = 'medium';
      else resultLevel = 'high';
      
      return results[resultLevel];
    }

    nextBtn.addEventListener('click', () => {
      if (currentQuestion < quizData.questions.length - 1) {
        currentQuestion++;
        renderQuestion();
        questionsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    prevBtn.addEventListener('click', () => {
      if (currentQuestion > 0) {
        currentQuestion--;
        renderQuestion();
        questionsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const result = calculateResults();
      
      const resultsContent = document.getElementById('resultsContent');
      resultsContent.innerHTML = `
        <div class="results-icon">${result.icon}</div>
        <h4 class="results-subtitle">${result.title}</h4>
        <p class="results-description">${result.description}</p>
      `;
      
      questionsContainer.style.display = 'none';
      document.querySelector('.quiz-premium__navigation').style.display = 'none';
      document.querySelector('.quiz-progress').style.display = 'none';
      resultsContainer.style.display = 'block';
      resultsContainer.scrollIntoView({ behavior: 'smooth' });
    });

    // Initial render
    renderQuestion();
  });
</script>

{% stylesheet %}
  .quiz-premium {
    max-width: 900px;
    margin: 0 auto;
    padding: 60px 40px;
  }

  .quiz-premium__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .quiz-premium__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    color: #5A1D4E;
    margin-bottom: 16px;
    position: relative;
    display: inline-block;
  }

  .quiz-premium__title::after {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 3px;
    background: linear-gradient(90deg, #D4AF37, transparent);
    border-radius: 2px;
  }

  .quiz-premium__description {
    font-size: 1.1rem;
    color: #2C2C2C;
    margin-top: 24px;
    line-height: 1.6;
  }

  .quiz-premium__container {
    background: linear-gradient(135deg, rgba(250, 250, 248, 0.95) 0%, rgba(232, 213, 224, 0.3) 100%);
    border-radius: 16px;
    padding: 40px;
    box-shadow: 0 12px 28px rgba(90, 29, 78, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.2);
  }

  .quiz-question {
    margin-bottom: 32px;
  }

  .quiz-question__text {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: #5A1D4E;
    margin-bottom: 24px;
    font-weight: 600;
  }

  .quiz-question__options {
    display: grid;
    gap: 12px;
  }

  .quiz-option {
    display: flex;
    align-items: center;
    padding: 16px;
    background: #FFFFFF;
    border: 2px solid #E8D5E0;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    gap: 12px;
  }

  .quiz-option:hover {
    border-color: #D4AF37;
    box-shadow: 0 4px 12px rgba(212, 175, 55, 0.1);
    background: rgba(212, 175, 55, 0.05);
  }

  .quiz-option input[type="radio"] {
    width: 20px;
    height: 20px;
    cursor: pointer;
    accent-color: #7B2869;
  }

  .quiz-option input[type="radio"]:checked + .quiz-option__label {
    color: #7B2869;
    font-weight: 600;
  }

  .quiz-option__label {
    flex: 1;
    font-weight: 500;
    color: #2C2C2C;
  }

  .quiz-premium__navigation {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  .button--secondary {
    border-color: #D4AF37 !important;
    color: #7B2869 !important;
  }

  .quiz-progress {
    margin-top: 32px;
    text-align: center;
  }

  .quiz-progress__bar {
    height: 6px;
    background: #E8D5E0;
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 12px;
  }

  .quiz-progress__fill {
    height: 100%;
    background: linear-gradient(90deg, #7B2869, #D4AF37);
    transition: width 0.3s ease;
    width: 0;
  }

  .quiz-progress__text {
    font-size: 0.875rem;
    color: #7B2869;
    font-weight: 600;
  }

  .quiz-premium__results {
    animation: fadeIn 0.5s ease;
  }

  .results-card {
    text-align: center;
  }

  .results-card__title {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: #5A1D4E;
    margin-bottom: 24px;
  }

  .results-icon {
    font-size: 80px;
    margin-bottom: 24px;
  }

  .results-subtitle {
    font-size: 1.5rem;
    color: #7B2869;
    margin-bottom: 16px;
    font-weight: 600;
  }

  .results-description {
    font-size: 1.1rem;
    color: #2C2C2C;
    line-height: 1.8;
    margin-bottom: 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .quiz-premium {
      padding: 40px 20px;
    }

    .quiz-premium__container {
      padding: 24px;
    }

    .quiz-premium__title {
      font-size: 1.75rem;
    }

    .quiz-premium__description {
      font-size: 1rem;
    }

    .quiz-question__text {
      font-size: 1.25rem;
    }

    .quiz-option {
      padding: 12px;
    }

    .quiz-premium__navigation {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Quiz Premium",
  "settings": [
    {
      "type": "text",
      "id": "quiz_title",
      "label": "Título del Quiz",
      "default": "Descubre Tu Nivel de Reconciliación"
    },
    {
      "type": "textarea",
      "id": "quiz_description",
      "label": "Descripción del Quiz",
      "default": "Responde estas 6 preguntas para descubrir en qué etapa te encuentras y recibir un diagnóstico personalizado."
    },
    {
      "type": "text",
      "id": "quiz_results_heading",
      "label": "Encabezado de Resultados",
      "default": "Tu Resultado"
    }
  ],
  "presets": [
    {
      "name": "Quiz Premium"
    }
  ]
}
{% endschema %}
