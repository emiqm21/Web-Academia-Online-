{% assign heading = section.settings.heading %}
{% assign subheading = section.settings.subheading %}
{% assign cta_text = section.settings.cta_text %}
{% assign cta_link = section.settings.cta_link %}
{% assign background_image = section.settings.background_image %}

<div class="hero-premium" style="{% if background_image %}background-image: url('{{ background_image | image_url: width: 1920 }}');{% endif %}">
  <div class="hero-premium__overlay"></div>
  
  <div class="hero-premium__content">
    <div class="hero-premium__text">
      {% if heading %}
        <h1 class="hero-premium__heading" data-aos="fade-down" data-aos-duration="1000">
          {{ heading }}
        </h1>
      {% endif %}
      
      {% if subheading %}
        <p class="hero-premium__subheading" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
          {{ subheading }}
        </p>
      {% endif %}
      
      {% if cta_text and cta_link %}
        <div class="hero-premium__cta" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="400">
          <a href="{{ cta_link }}" class="button button--primary button--large">
            {{ cta_text }}
            <span class="button__arrow">→</span>
          </a>
        </div>
      {% endif %}
    </div>
    
    <div class="hero-premium__decoration">
      <div class="decoration-circle decoration-circle--1"></div>
      <div class="decoration-circle decoration-circle--2"></div>
      <div class="decoration-line"></div>
    </div>
  </div>
  
  <div class="hero-premium__scroll-indicator">
    <span class="scroll-text">Desplázate</span>
    <svg class="scroll-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 5v14M19 12l-7 7-7-7"/>
    </svg>
  </div>
</div>

{% stylesheet %}
  .hero-premium {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--gradient-premium);
    background-size: cover;
    background-position: center;
    margin: 0;
    padding: 0;
  }

  .hero-premium__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(123, 40, 105, 0.85) 0%, rgba(90, 29, 78, 0.9) 100%);
    z-index: 1;
  }

  .hero-premium__content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    width: 100%;
    padding: 60px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 80px;
  }

  .hero-premium__text {
    flex: 1;
    color: #FFFFFF;
    text-align: left;
  }

  .hero-premium__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 24px;
    letter-spacing: -1.5px;
    text-shadow: 2px 4px 8px rgba(0, 0, 0, 0.2);
  }

  .hero-premium__heading::after {
    content: '';
    display: block;
    width: 80px;
    height: 4px;
    background: linear-gradient(90deg, #D4AF37, transparent);
    margin-top: 16px;
  }

  .hero-premium__subheading {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 300;
    line-height: 1.6;
    margin-bottom: 32px;
    color: rgba(255, 255, 255, 0.95);
    letter-spacing: 0.3px;
  }

  .hero-premium__cta {
    margin-top: 40px;
  }

  .button--large {
    padding: 16px 40px !important;
    font-size: 1.1rem !important;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
    position: relative;
    overflow: visible;
  }

  .button__arrow {
    display: inline-block;
    transition: transform 0.3s ease;
    font-size: 1.2em;
  }

  .button--large:hover .button__arrow {
    transform: translateX(4px);
  }

  /* Decorative Elements */
  .hero-premium__decoration {
    flex: 1;
    position: relative;
    height: 400px;
    display: none;
  }

  @media (min-width: 1024px) {
    .hero-premium__decoration {
      display: block;
    }
  }

  .decoration-circle {
    position: absolute;
    border-radius: 50%;
    background: rgba(212, 175, 55, 0.1);
    border: 2px solid rgba(212, 175, 55, 0.3);
    animation: float 6s ease-in-out infinite;
  }

  .decoration-circle--1 {
    width: 200px;
    height: 200px;
    top: 0;
    right: 0;
    animation-delay: 0s;
  }

  .decoration-circle--2 {
    width: 150px;
    height: 150px;
    bottom: 50px;
    right: 100px;
    animation-delay: 2s;
  }

  .decoration-line {
    position: absolute;
    width: 2px;
    height: 200px;
    background: linear-gradient(180deg, transparent, #D4AF37, transparent);
    right: 50%;
    top: 50%;
    transform: translateY(-50%);
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }

  /* Scroll Indicator */
  .hero-premium__scroll-indicator {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    letter-spacing: 1px;
    animation: bounce 2s ease-in-out infinite;
    cursor: pointer;
    z-index: 3;
  }

  .scroll-arrow {
    stroke: rgba(255, 255, 255, 0.7);
  }

  @keyframes bounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .hero-premium {
      min-height: 60vh;
      padding: 40px 0;
    }

    .hero-premium__content {
      flex-direction: column;
      padding: 40px 20px;
      gap: 40px;
      text-align: center;
    }

    .hero-premium__text {
      text-align: center;
    }

    .hero-premium__heading {
      font-size: 2rem;
      margin-bottom: 16px;
    }

    .hero-premium__heading::after {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-premium__subheading {
      font-size: 1rem;
      margin-bottom: 24px;
    }

    .button--large {
      width: 100%;
      justify-content: center;
    }

    .scroll-text {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .hero-premium__content {
      max-width: 1200px;
      padding: 80px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Premium",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Encabezado",
      "default": "Recupera a Tu Ex Pareja",
      "placeholder": "Ingresa tu encabezado principal"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Aprende las estrategias probadas y científicamente respaldadas para reconectar con tu ex y reconstruir una relación más fuerte que nunca.",
      "placeholder": "Ingresa tu subtítulo"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto del Botón CTA",
      "default": "Empezar Quiz Gratuito"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del Botón"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagen de Fondo (Opcional)"
    }
  ],
  "presets": [
    {
      "name": "Hero Premium"
    }
  ]
}
{% endschema %}
