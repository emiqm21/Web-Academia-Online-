{% assign heading = section.settings.heading %}
{% assign subheading = section.settings.subheading %}
{% assign edition_badge = section.settings.edition_badge %}
{% assign guarantee_text = section.settings.guarantee_text %}
{% assign cta_text = section.settings.cta_text %}
{% assign cta_link = section.settings.cta_link %}

<section class="hero-ebook" style="background: linear-gradient(135deg, #f7f1e8 0%, #fffaf3 100%);">
  <div class="hero-ebook__container">
    <!-- Badge de edición -->
    {% if edition_badge %}
      <div class="hero-ebook__badge" data-aos="fade-down">
        <span class="badge-text">{{ edition_badge }}</span>
      </div>
    {% endif %}

    <!-- Contenido principal -->
    <div class="hero-ebook__content" data-aos="fade-up" data-aos-duration="800">
      {% if heading %}
        <h1 class="hero-ebook__heading">
          {{ heading }}
        </h1>
      {% endif %}

      {% if subheading %}
        <p class="hero-ebook__subheading">
          {{ subheading }}
        </p>
      {% endif %}

      <!-- Guarantee badge -->
      {% if guarantee_text %}
        <div class="hero-ebook__guarantee">
          <svg class="guarantee-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>{{ guarantee_text }}</span>
        </div>
      {% endif %}
    </div>

    <!-- CTA principal -->
    {% if cta_text and cta_link %}
      <div class="hero-ebook__cta-container" data-aos="fade-up" data-aos-duration="800" data-aos-delay="200">
        <a href="{{ cta_link }}" class="hero-ebook__cta button-primary">
          {{ cta_text }}
          <span class="cta-arrow">→</span>
        </a>
        <p class="hero-ebook__cta-subtext">Acceso instantáneo al descargable</p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hero-ebook {
    padding: 80px 20px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-ebook__container {
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-ebook__badge {
    display: inline-block;
    margin-bottom: 24px;
  }

  .badge-text {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: #e85f2a;
    text-transform: uppercase;
  }

  .hero-ebook__heading {
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 24px;
    color: #171719;
    letter-spacing: -1px;
  }

  .hero-ebook__subheading {
    font-size: 1.25rem;
    line-height: 1.6;
    color: #5c5c66;
    margin-bottom: 32px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-ebook__guarantee {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(15, 143, 95, 0.1);
    padding: 12px 24px;
    border-radius: 8px;
    margin-bottom: 40px;
    font-size: 0.95rem;
    color: #0f8f5f;
    font-weight: 500;
  }

  .guarantee-icon {
    flex-shrink: 0;
  }

  .hero-ebook__cta-container {
    margin-top: 40px;
  }

  .hero-ebook__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #e85f2a;
    color: white;
    padding: 18px 48px;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 2px solid #e85f2a;
  }

  .hero-ebook__cta:hover {
    background: #d14a1a;
    border-color: #d14a1a;
    transform: translateY(-2px);
  }

  .cta-arrow {
    transition: transform 0.3s ease;
  }

  .hero-ebook__cta:hover .cta-arrow {
    transform: translateX(4px);
  }

  .hero-ebook__cta-subtext {
    margin-top: 16px;
    font-size: 0.95rem;
    color: #5c5c66;
  }

  @media (max-width: 768px) {
    .hero-ebook {
      padding: 60px 20px;
    }

    .hero-ebook__heading {
      margin-bottom: 20px;
    }

    .hero-ebook__subheading {
      font-size: 1.1rem;
      margin-bottom: 28px;
    }

    .hero-ebook__cta {
      width: 100%;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero - Ebook Persuasivo",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recupera a Tu Ex Pareja"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Una guía basada en psicología para entender la ruptura y aplicar estrategias prácticas de reconexión."
    },
    {
      "type": "text",
      "id": "edition_badge",
      "label": "Edition Badge",
      "default": "Segunda Edición Mejorada"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee Text",
      "default": "Garantía de 30 días. Dinero de vuelta si no te convence."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Acceder Ahora"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    }
  ]
}
{% endschema %}
